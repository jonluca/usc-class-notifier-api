{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "arrowParens": "always",
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [".yarn", "public/js", "prisma/generated", ".plasmo", ".next", ".expo", ".claude", ".cursor"]
}
