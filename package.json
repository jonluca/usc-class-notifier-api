{
  "name": "class-notifier-api",
  "displayName": "USC Schedule Helper",
  "homepage": "https://usc.jonlu.ca",
  "description": "A tool to help you find classes at USC",
  "author": "JonLuca DeCaro <usc-schedule-helper@jonlu.ca>",
  "version": "15.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production next build && next start",
    "dev": "NODE_ENV=development next dev",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx' 'jobs/**/*.test.ts'",
    "dev:email": "email dev --dir src/emails --port 3001",
    "postinstall": "wxt prepare && prisma generate",
    "typecheck": "tsc --noEmit",
    "monitor": "tsx jobs/monitor.ts",
    "refresh-rmp": "tsx jobs/refreshRmpData.ts && oxfmt src/data",
    "dev:extension": "NODE_ENV=development wxt",
    "dev:firefox": "NODE_ENV=development wxt -b firefox --mv3",
    "build": "NODE_ENV=production next build",
    "heroku-build": "NODE_ENV=production next build --webpack",
    "build:extension": "pnpm run build:chrome && pnpm run build:edge && pnpm run build:firefox && pnpm run build:safari",
    "build:chrome": "NODE_ENV=production wxt build -b chrome --mv3",
    "build:edge": "NODE_ENV=production wxt build -b edge --mv3",
    "build:firefox": "NODE_ENV=production wxt build -b firefox --mv3",
    "build:safari": "NODE_ENV=production wxt build -b safari --mv3",
    "package:extension": "NODE_ENV=production wxt zip",
    "package:firefox": "NODE_ENV=production wxt zip -b firefox --mv3",
    "zip": "pnpm run zip:chrome && pnpm run zip:edge && pnpm run zip:firefox && pnpm run zip:safari",
    "zip:chrome": "NODE_ENV=production wxt zip -b chrome --mv3",
    "zip:edge": "NODE_ENV=production wxt zip -b edge --mv3",
    "zip:firefox": "NODE_ENV=production wxt zip -b firefox --mv3",
    "zip:safari": "NODE_ENV=production wxt zip -b safari --mv3",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "submit:firefox": "web-ext sign --source-dir .output/firefox-mv3 --channel=listed --amo-metadata=amo-metadata.json --upload-source-code=.output/class-notifier-api-${npm_package_version}-sources.zip --artifacts-dir=.output/firefox-signed"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1158.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@trpc/client": "^11.19.0",
    "@trpc/next": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/chrome": "0.3.7",
    "@types/jquery": "^4.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "@wxt-dev/storage": "^1.3.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "axios": "^1.21.0",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "email-validator": "^2.0.4",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "jquery": "^4.0.0",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "mailparser": "^3.12.4",
    "next": "^16.4.3",
    "p-map": "^7.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "prisma-json-types-generator": "^5.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.4",
    "react-toastify": "^11.1.0",
    "sharp": "^0.35.5",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "toad-scheduler": "^4.2.0",
    "tsx": "^4.23.15",
    "twilio": "6.2.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3",
    "vite": "^8.3.5",
    "winston": "^3.19.0",
    "wxt": "^0.21.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@react-email/ui": "^6.11.4",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.75.0",
    "oxlint": "1.90.0",
    "web-ext": "^10.8.0"
  }
}
