{
  "name": "class-notifier-api",
  "displayName": "USC Schedule Helper",
  "homepage": "https://usc.jonlu.ca",
  "description": "A tool to help you find classes at USC",
  "author": "JonLuca DeCaro <usc-schedule-helper@jonlu.ca>",
  "version": "15.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production next build && next start",
    "dev": "NODE_ENV=development next dev",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx' 'jobs/**/*.test.ts'",
    "dev:email": "email dev --dir src/emails --port 3001",
    "postinstall": "wxt prepare && prisma generate",
    "typecheck": "tsc --noEmit",
    "monitor": "tsx jobs/monitor.ts",
    "refresh-rmp": "tsx jobs/refreshRmpData.ts && oxfmt src/data",
    "dev:extension": "NODE_ENV=development wxt",
    "dev:firefox": "NODE_ENV=development wxt -b firefox --mv3",
    "build": "NODE_ENV=production next build",
    "build:extension": "yarn build:chrome && yarn build:edge && yarn build:firefox && yarn build:safari",
    "build:chrome": "NODE_ENV=production wxt build -b chrome --mv3",
    "build:edge": "NODE_ENV=production wxt build -b edge --mv3",
    "build:firefox": "NODE_ENV=production wxt build -b firefox --mv3",
    "build:safari": "NODE_ENV=production wxt build -b safari --mv3",
    "package:extension": "NODE_ENV=production wxt zip",
    "package:firefox": "NODE_ENV=production wxt zip -b firefox --mv3",
    "zip": "yarn zip:chrome && yarn zip:edge && yarn zip:firefox && yarn zip:safari",
    "zip:chrome": "NODE_ENV=production wxt zip -b chrome --mv3",
    "zip:edge": "NODE_ENV=production wxt zip -b edge --mv3",
    "zip:firefox": "NODE_ENV=production wxt zip -b firefox --mv3",
    "zip:safari": "NODE_ENV=production wxt zip -b safari --mv3",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "submit:firefox": "web-ext sign --source-dir .output/firefox-mv3 --channel=listed --amo-metadata=amo-metadata.json --upload-source-code=.output/class-notifier-api-${npm_package_version}-sources.zip --artifacts-dir=.output/firefox-signed"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1109.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/chrome": "0.2.5",
    "@types/jquery": "^4.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "@wxt-dev/storage": "^1.2.9",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "axios": "^1.19.0",
    "cookie": "^2.0.1",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "email-validator": "^2.0.4",
    "html-to-text": "^10.0.0",
    "imapflow": "^1.7.0",
    "jquery": "^4.0.0",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "mailparser": "^3.9.15",
    "moment": "^2.30.1",
    "next": "^16.3.0",
    "p-map": "^7.0.6",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "prisma-json-types-generator": "^5.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "react-toastify": "^11.1.0",
    "sharp": "^0.35.3",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.3.3",
    "toad-scheduler": "^4.1.0",
    "tsx": "^4.23.12",
    "twilio": "6.1.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1",
    "vite": "^8.2.1",
    "winston": "^3.19.0",
    "wxt": "^0.21.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "adm-zip": "0.6.0",
    "brace-expansion@^1.1.7": "1.1.18",
    "brace-expansion@^2.0.2": "2.1.4",
    "brace-expansion@^5.0.5": "5.0.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "next": "16.3.0",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "svgo": "4.0.2",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "valibot": "1.4.2"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.2",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/pg": "^8.21.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "web-ext": "^10.6.0"
  }
}
